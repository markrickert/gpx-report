POSTGRES_USER=gpxuser
POSTGRES_PASSWORD=gpxpassword
POSTGRES_DB=gpxreport

# Public domains the frontend build bakes in (EXPO_PUBLIC_GRAPHQL_URL/EXPO_PUBLIC_CODE_SERVER_URL
# build args in docker-compose.yml) — set to the real Caddy-proxied domains here so
# they never need to be committed to docker-compose.yml itself.
EXPO_PUBLIC_GRAPHQL_URL=https://gpx-report-api.example.com/graphql
EXPO_PUBLIC_CODE_SERVER_URL=https://gpx-report-code.example.com
