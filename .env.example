POSTGRES_USER=gpxuser
POSTGRES_PASSWORD=gpxpassword
POSTGRES_DB=gpxreport

# Public API domain the frontend build bakes in (EXPO_PUBLIC_GRAPHQL_URL build arg
# in docker-compose.yml) — set to the real proxied domain here so it never needs
# to be committed to docker-compose.yml itself.
EXPO_PUBLIC_GRAPHQL_URL=https://gpx-report-api.example.com/graphql
