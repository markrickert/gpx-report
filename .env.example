POSTGRES_USER=gpxuser
POSTGRES_PASSWORD=gpxpassword
POSTGRES_DB=gpxreport

# Public domains the frontend build bakes in (VITE_GRAPHQL_URL/VITE_CODE_SERVER_URL
# build args in docker-compose.yml) — set to the real Caddy-proxied domains here so
# they never need to be committed to docker-compose.yml itself.
VITE_GRAPHQL_URL=https://gpx-report-api.example.com/graphql
VITE_CODE_SERVER_URL=https://gpx-report-code.example.com
