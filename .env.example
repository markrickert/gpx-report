POSTGRES_USER=gpxuser
POSTGRES_PASSWORD=gpxpassword
POSTGRES_DB=gpxreport

# Only for hot-reload dev mode (docker-compose.dev.yml): the Metro dev server has
# no proxy, so point it at the backend. The production web image ignores this and
# calls /graphql on its own origin.
# EXPO_PUBLIC_GRAPHQL_URL=http://localhost:4000/graphql
