# Serves the exported web app and proxies the API, so the whole app lives on
# one origin: /graphql and /api/* go to the backend, everything else is the
# single-page app (unknown paths fall back to index.html for client routing).
{
	admin off
}

:3000 {
	handle /graphql* {
		reverse_proxy backend:4000
	}
	handle /api/* {
		reverse_proxy backend:4000
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
