{
  "name": "gpx-report",
  "private": true,
  "packageManager": "pnpm@11.0.9",
  "version": "1.0.0",
  "scripts": {
    "prepare": "husky",
    "lint": "pnpm --dir backend lint && pnpm --dir frontend lint",
    "format": "pnpm --dir backend format && pnpm --dir frontend format"
  },
  "devDependencies": {
    "husky": "^9.1.5",
    "lint-staged": "^15.2.9",
    "prettier": "^3.3.3"
  },
  "lint-staged": {
    "backend/**/*.ts": [
      "backend/node_modules/.bin/eslint --config backend/eslint.config.js --fix",
      "prettier --write"
    ],
    "frontend/**/*.{ts,tsx}": [
      "sh -c 'cd frontend && node_modules/.bin/eslint --fix \"$@\"' --",
      "prettier --write"
    ]
  }
}
